# Copie para .env e preencha.

# Supabase (Project Settings > API). A anon key é pública por design;
# a segurança vem das políticas RLS em supabase/migrations.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Gemini: usada só na Netlify Function, nunca vai para o navegador.
GEMINI_API_KEY=
